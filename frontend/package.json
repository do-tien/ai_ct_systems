{
  "name": "nodule-reader-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test:geometry": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "test:initialread": "node --experimental-strip-types --test \"tests/initialread-*.test.ts\"",
    "test:upload": "node --experimental-strip-types --test \"tests/upload-*.test.ts\""
  },
  "dependencies": {
    "@cornerstonejs/core": "4.22.13",
    "@cornerstonejs/dicom-image-loader": "4.22.13",
    "@cornerstonejs/tools": "4.22.13",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
