# Local development defaults for the nodule-reader stack.
# These are public demo credentials: local development only, never production secrets.
# Copy to .env (git-ignored) before running Docker Compose.

POSTGRES_DB=nodule
POSTGRES_USER=nodule
POSTGRES_PASSWORD=nodule-dev-only

# Orthanc credentials must use only letters, numbers, hyphen, or underscore so the
# Compose-generated JSON for ORTHANC__REGISTERED_USERS stays valid.
ORTHANC_USER=nodule
ORTHANC_PASSWORD=orthanc-dev-only

FRONTEND_PORT=5173
BACKEND_PORT=8080
