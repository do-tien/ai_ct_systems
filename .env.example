# Local development defaults for the nodule-reader stack.
# These are public demo credentials: local development only, never production secrets.
# Copy to .env (git-ignored) before running Docker Compose.

POSTGRES_DB=nodule
POSTGRES_USER=nodule
POSTGRES_PASSWORD=nodule-dev-only

# Orthanc credentials must use only letters, numbers, hyphen, or underscore so the
# Compose-generated JSON for ORTHANC__REGISTERED_USERS stays valid.
ORTHANC_USER=nodule
ORTHANC_PASSWORD=orthanc-dev-only

FRONTEND_PORT=5173
BACKEND_PORT=8080

# PIN authentication. AUTH_PIN_PEPPER is required by both the backend and the
# `userctl` administration CLI; it must be unpadded base64url encoding exactly
# 32 random bytes. Generate one per environment and keep it secret, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The placeholder below is intentionally invalid so an unconfigured deployment
# fails loudly instead of using a public pepper. Never commit a real pepper.
AUTH_PIN_PEPPER=replace-with-32-random-bytes-base64url

# Session cookie Secure flag: true or false (default false). Keep false only
# for loopback HTTP development; set true for every HTTPS deployment. The
# session cookie is always HttpOnly and SameSite=Strict.
AUTH_COOKIE_SECURE=false
